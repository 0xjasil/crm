{
  "name": "crm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRM Backend built with Fastify, TypeScript, Prisma, and PostgreSQL",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate && npx tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:master": "tsx scripts/seed-master-data.ts",
    "db:migrate": "prisma migrate dev",
    "test": "tsx --test src/modules/invoices/money.test.ts src/modules/invoices/payment.utils.test.ts src/modules/invoices/invoice-tax.test.ts src/modules/enquiries/enquiry-list.test.ts src/modules/enquiries/enquiry-detail.test.ts src/modules/enquiries/enquiry-mutations.test.ts src/modules/enquiries/enquiry-assignment.test.ts src/modules/workflows/installation-progress.test.ts src/modules/workflows/workflow.routes.test.ts src/modules/workflows/auth.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@pdfme/common": "^4.5.2",
    "@pdfme/generator": "^4.5.2",
    "@pdfme/schemas": "^4.5.2",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
